class_name MapData
extends RefCounted
## Land polygons and institution places in a projected plane, from data/map/lands.json
## (generated by tools/map/build_map.py).

const PATH := "res://data/map/lands.json"

## Size of the projected plane.
var size: Vector2
## Polygons per land id.
var lands: Dictionary[String, Array] = {}
## Land ids from smallest to largest area; hit tests use this order, so a land
## inside another (Berlin in Brandenburg) is found first.
var lands_by_area: Array[String] = []
## Projected position per place id (institutions and media houses).
var places: Dictionary[String, Vector2] = {}


## Loads the map. Returns null if the file is missing or malformed.
static func load_default() -> MapData:
	var raw: Variant = JSON.parse_string(FileAccess.get_file_as_string(PATH))
	if typeof(raw) != TYPE_DICTIONARY:
		push_error("Cannot read map data at %s" % PATH)
		return null
	var map := MapData.new()
	map.size = Vector2(raw["width"], raw["height"])
	var areas: Dictionary[String, float] = {}
	for land_id: String in raw["lands"]:
		var polygons: Array[PackedVector2Array] = []
		var area := 0.0
		for ring: Array in raw["lands"][land_id]:
			var polygon := PackedVector2Array()
			for i in range(0, ring.size(), 2):
				polygon.append(Vector2(ring[i], ring[i + 1]))
			polygons.append(polygon)
			area += absf(_signed_area(polygon))
		map.lands[land_id] = polygons
		areas[land_id] = area
	map.lands_by_area.assign(areas.keys())
	map.lands_by_area.sort_custom(func(a: String, b: String) -> bool: return areas[a] < areas[b])
	for place_id: String in raw["places"]:
		map.places[place_id] = Vector2(raw["places"][place_id][0], raw["places"][place_id][1])
	return map


## Returns the land at a point of the plane, or an empty string.
func land_at(point: Vector2) -> String:
	for land_id in lands_by_area:
		for polygon: PackedVector2Array in lands[land_id]:
			if Geometry2D.is_point_in_polygon(point, polygon):
				return land_id
	return ""


## Returns the bounding box of the given lands in the plane.
func bounds(land_ids: Array) -> Rect2:
	var box := Rect2()
	var first := true
	for land_id: String in land_ids:
		for polygon: PackedVector2Array in lands[land_id]:
			for point in polygon:
				if first:
					box = Rect2(point, Vector2.ZERO)
					first = false
				else:
					box = box.expand(point)
	return box


static func _signed_area(polygon: PackedVector2Array) -> float:
	var area := 0.0
	for i in polygon.size():
		var a := polygon[i]
		var b := polygon[(i + 1) % polygon.size()]
		area += a.x * b.y - b.x * a.y
	return area / 2.0
